{
  "name": "dsh-security",
  "description": "DSH security audit plugin: find, validate, and report vulnerabilities (equivalent rebuild of codex-security methodology, skills + workflow capsules only).",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
